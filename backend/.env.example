# ConnectX Backend Environment Configuration Example
# Copy to .env for local development

# Environment Mode: development | staging | production | test
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ConnectX Universal Social Ecosystem"
API_V1_STR="/api/v1"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security & Secrets (Must be changed in production)
SECRET_KEY=dev-secret-key-change-in-production-connectx-backend-2026
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16+)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=connectx
POSTGRES_PASSWORD=connectx_secure_pass
POSTGRES_DB=connectx
# Async SQLAlchemy Database URL (used by FastAPI and SQLAlchemy 2.x async engine)
DATABASE_URL=postgresql+asyncpg://connectx:connectx_secure_pass@localhost:5432/connectx
# Sync Database URL (used by Alembic migrations if needed)
SYNC_DATABASE_URL=postgresql+psycopg2://connectx:connectx_secure_pass@localhost:5432/connectx

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Cache / Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# S3 / Object Storage Configuration (MinIO / AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MEDIA=connectx-media
S3_BUCKET_FILES=connectx-files
S3_REGION=us-east-1

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
